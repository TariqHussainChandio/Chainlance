NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK credentials. Use one of:
#  - FIREBASE_SERVICE_ACCOUNT_KEY: JSON string of the service account.
#    Required for production (Vercel filesystem is ephemeral).
#  - FIREBASE_ADMIN_KEY_PATH: filesystem path to the key file.
#    Sufficient for local dev.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_ADMIN_KEY_PATH=./firebase-admin.json

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App branding + the base URL that Firebase email-link signins redirect
# back to. NEXT_PUBLIC_APP_URL must point at the deployed origin (no
# trailing slash) — e.g. https://chainwork.vercel.app.
NEXT_PUBLIC_APP_NAME=ChainWork
NEXT_PUBLIC_APP_URL=http://localhost:3000
