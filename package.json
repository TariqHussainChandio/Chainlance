{
  "name": "chainwork-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev",
